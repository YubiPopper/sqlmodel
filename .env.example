# OpenAI API Key - Default AI provider
# Get your API key from https://platform.openai.com/api-keys
# The app uses GPT-4o-Mini by default, which can be overridden in AI Settings
VITE_OPENAI_API_KEY=your-openai-api-key-here

# Real-time collaboration signaling server
# Deploy signaling-server/ to Render/Railway (free) then paste the wss:// URL here.
# See signaling-server/README.md for step-by-step instructions.
VITE_SIGNALING_URL=wss://your-signaling-server.onrender.com
